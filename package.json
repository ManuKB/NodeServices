{
  "name": "expense-tracker",
  "version": "1.0.0",
  "description": "Full-stack expense tracker monorepo with React Vite frontend and Express backend",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @expense-tracker/server",
    "dev:client": "npm run dev -w @expense-tracker/client",
    "build:client": "npm run build -w @expense-tracker/client",
    "start": "npm run start -w @expense-tracker/server",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "lint": "npm run lint -w @expense-tracker/client",
    "typecheck": "npm run typecheck -w @expense-tracker/client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "lerna": "^8.1.0"
  }
}
